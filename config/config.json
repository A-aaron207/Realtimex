{
  "kernel": {
    "name": "realtimex-kernel",
    "version": "1.0.0",
    "environment": "production"
  },
  "logging": {
    "level": "DEBUG",
    "filename": "kernel.log"
  },
  "event_bus": {
    "enabled": true,
    "history_max_size": 10000,
    "persistence_filename": "events.jsonl",
    "event_log_filename": "event_log.jsonl"
  },
  "task_system": {
    "enabled": true,
    "tasks_directory": "tasks"
  },
  "workflow_engine": {
    "enabled": true,
    "workflows_directory": "workflows"
  },
  "service_registry": {
    "enabled": true
  },
  "capability_registry": {
    "enabled": true
  },
  "recovery_manager": {
    "enabled": true
  },
  "model_gateway": {
    "default_provider": "openrouter",
    "providers": {
      "anthropic": {
        "model": "claude-3-5-sonnet"
      },
      "openai": {
        "model": "gpt-4o"
      },
      "openrouter": {
        "model": "meta-llama/llama-3.1-70b-instruct"
      },
      "gemini": {
        "model": "gemini-1.5-pro"
      },
      "mock": {
        "model": "mock-model"
      }
    }
  }
}