{
  "kernel": {
    "name": "realtimex-kernel",
    "version": "1.0.0",
    "environment": "production"
  },
  "logging": {
    "level": "INFO",
    "filename": "kernel.log"
  },
  "event_bus": {
    "enabled": true,
    "history_max_size": 10000,
    "persistence_filename": "events.jsonl",
    "event_log_filename": "event_log.jsonl"
  },
  "task_system": {
    "enabled": true,
    "tasks_directory": "tasks"
  },
  "workflow_engine": {
    "enabled": true,
    "workflows_directory": "workflows"
  },
  "service_registry": {
    "enabled": true
  },
  "capability_registry": {
    "enabled": true
  },
  "recovery_manager": {
    "enabled": true
  },
  "model_gateway": {
    "default_provider": "openrouter",
    "providers": {
      "anthropic": {
        "model": "claude-3-5-sonnet"
      },
      "openai": {
        "model": "gpt-4o"
      },
      "openrouter": {
        "model": "meta-llama/llama-3.1-70b-instruct"
      },
      "gemini": {
        "model": "gemini-1.5-pro"
      },
      "mock": {
        "model": "mock-model"
      }
    },
    "capabilities": {
      "reasoning": {
        "primary": {
          "provider": "openrouter",
          "model": "deepseek/deepseek-r1"
        },
        "fallback": {
          "provider": "groq",
          "model": "llama-3.3-70b"
        }
      },
      "coding": {
        "primary": {
          "provider": "groq",
          "model": "qwen-coder"
        },
        "fallback": {
          "provider": "openrouter",
          "model": "meta-llama/llama-3.1-70b-instruct"
        }
      },
      "chat": {
        "primary": {
          "provider": "groq",
          "model": "gemma"
        },
        "fallback": {
          "provider": "openrouter",
          "model": "meta-llama/llama-3.1-70b-instruct"
        }
      },
      "vision": {
        "primary": {
          "provider": "openrouter",
          "model": "google/gemini-flash-1.5"
        },
        "fallback": {
          "provider": "gemini",
          "model": "gemini-1.5-flash"
        }
      },
      "summarization": {
        "primary": {
          "provider": "groq",
          "model": "llama-3.3-70b"
        },
        "fallback": {
          "provider": "openrouter",
          "model": "meta-llama/llama-3.1-70b-instruct"
        }
      },
      "classification": {
        "primary": {
          "provider": "groq",
          "model": "llama-3.3-70b"
        },
        "fallback": {
          "provider": "openrouter",
          "model": "meta-llama/llama-3.1-70b-instruct"
        }
      },
      "planning": {
        "primary": {
          "provider": "openrouter",
          "model": "deepseek/deepseek-r1"
        },
        "fallback": {
          "provider": "groq",
          "model": "llama-3.3-70b"
        }
      },
      "repair": {
        "primary": {
          "provider": "openrouter",
          "model": "deepseek/deepseek-r1"
        },
        "fallback": {
          "provider": "groq",
          "model": "llama-3.3-70b"
        }
      },
      "translation": {
        "primary": {
          "provider": "groq",
          "model": "gemma"
        },
        "fallback": {
          "provider": "openrouter",
          "model": "meta-llama/llama-3.1-70b-instruct"
        }
      },
      "tool_selection": {
        "primary": {
          "provider": "groq",
          "model": "gemma"
        },
        "fallback": {
          "provider": "openrouter",
          "model": "meta-llama/llama-3.1-70b-instruct"
        }
      },
      "intent_detection": {
        "primary": {
          "provider": "groq",
          "model": "gemma"
        },
        "fallback": {
          "provider": "openrouter",
          "model": "meta-llama/llama-3.1-70b-instruct"
        }
      }
    }
  }
}