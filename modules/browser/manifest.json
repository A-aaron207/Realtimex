{
  "module_id": "browser",
  "name": "Browser Module",
  "version": "1.0.0",
  "author": "Aaron",
  "capabilities": [
    "navigate",
    "extract_content",
    "click_element",
    "fill_form"
  ],
  "services": [
    "logger",
    "model_gateway"
  ],
  "worker_type": "replicable",
  "permissions": {
    "filesystem": "read",
    "network": true,
    "terminal": false,
    "memory": "task_only"
  }
}
